{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "maxDuration": 30,
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/((?!api/|assets/|sw\\.js|workbox-.*|manifest\\.webmanifest|registerSW\\.js|favicon\\.ico|robots\\.txt).*)",
      "destination": "/index.html"
    }
  ]
}
