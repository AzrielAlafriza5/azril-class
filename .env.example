# GEMINI_API_KEY: Required for Gemini AI API calls (AI Assistant Human-in-the-Loop).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE (New Database Project — Optional for local preview; required for production Supabase mode)
# Never reuse legacy Android Supabase URL or keys.
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ADMIN ACCOUNT & SESSION (Disarankan diisi pada Vercel/Serverless agar akun Admin tunggal & sesi bertahan setelah cold start / restart)
# Portal Admin hanya menampilkan halaman login (tanpa pendaftaran Admin baru).
ADMIN_BOOTSTRAP_USERNAME="azriel-admin"
ADMIN_BOOTSTRAP_EMAIL="azrilalafriza5@gmail.com"
ADMIN_BOOTSTRAP_PASSWORD=""
# Gunakan string acak panjang (32+ karakter) agar token sesi tidak berubah saat server restart
SESSION_SECRET=""
