# GEMINI_API_KEY: Required for Gemini AI API calls (AI Assistant Human-in-the-Loop).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE (New Database Project — Optional for local preview; required for production Supabase mode)
# Never reuse legacy Android Supabase URL or keys.
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ADMIN BOOTSTRAP & SESSION (Disarankan diisi pada Vercel/Serverless agar akun Admin & sesi bertahan setelah cold start / restart)
# Jika ADMIN_BOOTSTRAP_PASSWORD tidak diisi dan database belum memiliki Admin, layar "Buat Akun Admin Utama" akan muncul otomatis.
ADMIN_BOOTSTRAP_USERNAME=""
ADMIN_BOOTSTRAP_EMAIL=""
ADMIN_BOOTSTRAP_PASSWORD=""
# Gunakan string acak panjang (32+ karakter) agar token sesi tidak berubah saat server restart
SESSION_SECRET=""
